<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aplikasi Cuaca (LinearLayout)"
        android:textStyle="bold"
        android:textSize="20sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvKota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kota: Bandung"
        android:textSize="18sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvSuhu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suhu: 24°C"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvKondisi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kondisi: Hujan"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh (Dummy)"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Info: Data contoh (tanpa internet)"
        android:layout_marginTop="12dp"
        android:gravity="center"/>
</LinearLayout>
